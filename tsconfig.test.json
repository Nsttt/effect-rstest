{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "include": ["src", "test", "rslib.config.ts", "rstest.config.ts"],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "erasableSyntaxOnly": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "effect-rstest": ["./src/index.ts"],
      "effect-rstest/*": ["./src/*.ts"]
    }
  }
}
